# Copy to .env for local Docker runs, or enter these in the Render "Environment" page.
# Never commit a filled-in .env: this repo is public.

# Signs the session cookies. Any long random string.
OSP_SECRET=change-me-to-a-long-random-string

# Empty = no password. Admin can upload Excel and set targets; view protects reading the report.
OSP_ADMIN_PASSWORD=
OSP_VIEW_PASSWORD=
